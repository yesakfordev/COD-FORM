# ==============================================================================
# SHOPIFY COD & NOTION SYNC CONFIGURATION
# ==============================================================================

# Server Port (for local testing)
PORT=3000

# ------------------------------------------------------------------------------
# 1. SHOPIFY STORE CREDENTIALS (Required)
# ------------------------------------------------------------------------------
# Your Shopify store myshopify domain (e.g. yourstore.myshopify.com)
SHOPIFY_STORE=yourstore.myshopify.com

# Shopify Admin API Access Token (shpat_xxxxxxxxxxxxxxxxxxxxxxxx)
# Permissions needed:
# - write_orders, read_orders
# - write_draft_orders, read_draft_orders
# - write_customers, read_customers
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify API Version (Default: 2025-01)
SHOPIFY_API_VERSION=2025-01

# Order Creation Mode:
# "draft_order" (Recommended for COD - creates a draft order for review/confirmation)
# "order" (Creates a confirmed pending order directly)
SHOPIFY_ORDER_TYPE=draft_order

# Shopify Webhook Secret (from Shopify Admin -> Settings -> Notifications -> Webhooks)
# Used to verify signature for orders/create and draft_orders/create webhooks
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# ------------------------------------------------------------------------------
# 2. COD SECURITY & CORS (Required)
# ------------------------------------------------------------------------------
# Secret API key shared between your Shopify theme frontend and this backend
COD_API_KEY=your_generated_random_secret_api_key_here

# Allowed origins for CORS (comma-separated, e.g. custom domain + shopify domain)
ALLOWED_ORIGINS=https://yourstore.com,https://www.yourstore.com,https://yourstore.myshopify.com

# ------------------------------------------------------------------------------
# 3. NOTION INTEGRATION (Required for Notion Sync)
# ------------------------------------------------------------------------------
# Notion Internal Integration Token (secret_... or ntn_...)
# Create this at https://www.notion.so/profile/integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID for Draft Orders
# Connect your Notion database to your integration!
NOTION_DATABASE_ID=your_draft_orders_database_id_here

# Notion Database ID for Orders / Delivery (Optional: falls back to NOTION_DATABASE_ID)
NOTION_DELIVERY_DATABASE_ID=your_orders_delivery_database_id_here

# ------------------------------------------------------------------------------
# 4. FACEBOOK CONVERSIONS API / META PIXEL (Optional)
# ------------------------------------------------------------------------------
FB_PIXEL_ID=
FB_CAPI_TOKEN=
FB_TEST_EVENT_CODE=
